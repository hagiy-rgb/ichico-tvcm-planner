{
  "schema_version": "1.0",
  "created": "2026-05-15",
  "owner": "ICHICO",
  "description": "テレビCMシミュレーター用 業界係数マスタ。アドストック減衰λ、認知変換率α、ポアソン到達係数kの業界別・商材別実証値。各係数にsource（出典）とquality（信頼度A/B/C）を付与し、営業が出典を即答できる設計。",

  "model_definition": {
    "adstock": "Adstock_t = alpha_conv * GRP_t + lambda * Adstock_(t-1)",
    "awareness": "Awareness_t[%] = max_awareness * Adstock_t / (Adstock_t + half_saturation_adstock)（Michaelis-Menten型飽和、FSD v1.1 §3.8）",
    "reach": "Reach = N_pop * (1 - POISSON(F-1, k * GRP, TRUE))",
    "default_period": "weekly",
    "alpha_conversion_default": {
      "min": 0.2,
      "typical": 0.3,
      "max": 0.4,
      "quality": "B",
      "source": "FSD v1.1 採用（即時効果係数α、業界目安0.2-0.4）"
    },
    "awareness_saturation_default": {
      "max_awareness": {
        "min": 5,
        "typical": 30,
        "max": 100,
        "unit": "%",
        "quality": "C",
        "source": "FSD v1.1 §3.8（最大到達認知率 MaxAwareness。商材により可変）"
      },
      "half_saturation_adstock": {
        "min": 10,
        "typical": 50,
        "max": 300,
        "quality": "C",
        "source": "FSD v1.1 §3.8（認知率の半飽和点 K。要キャリブレーション）"
      }
    },
    "alpha_awareness_note": "業界別 alpha_awareness（%/GRP）は旧線形モデルの参考値。飽和式のキャリブレーション時の参照用で、計算には使用しない",
    "half_life_formula": "t_half = ln(0.5) / ln(lambda)",
    "period_conversion": {
      "weekly_to_monthly": "lambda_m = lambda_w ^ 4.345",
      "weekly_to_daily": "lambda_d = lambda_w ^ (1/7)"
    }
  },

  "quality_legend": {
    "A": "査読論文・大規模実証研究に基づく",
    "B": "業界白書・ICHICO自社実証データに基づく",
    "C": "理論推定・限定的根拠（業界購買サイクルからの推定）"
  },

