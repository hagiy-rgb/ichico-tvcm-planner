# === ローカル開発 ===
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here

# Auth.js v5 でも同じ値を AUTH_* に指定可能
# AUTH_URL=http://localhost:3000
# AUTH_SECRET=your-random-secret-here

# Google OAuth (Cloud Console → 認証情報 → OAuth 2.0 クライアント ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 承認済みリダイレクト URI（開発）:
#   http://localhost:3000/api/auth/callback/google

# === Vercel 本番（デプロイ後に Vercel ダッシュボード → Settings → Environment Variables で設定）===
# NEXTAUTH_URL=https://your-app.vercel.app
# NEXTAUTH_SECRET=（ローカルと同じ乱数で可。本番専用の新規生成を推奨）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Google Cloud Console に本番 URI も追加:
#   https://your-app.vercel.app/api/auth/callback/google
#
# 変数は Production（および Preview で試す場合は Preview）にチェックを入れる
